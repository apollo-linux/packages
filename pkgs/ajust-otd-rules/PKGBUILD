pkgname=ajust-otd-rules
# pkgver should be the latest 
pkgver=0.6.7 # renovate: datasource=github-tags depName=OpenTabletDriver/OpenTabletDriver
pkgrel=1
epoch=
pkgdesc="Dormant OpenTabletDriver rules for image-based OSes, intended to be enabled on-demand with a command runner"
arch=('x86_64')
url="https://github.com/OpenTabletDriver/OpenTabletDriver"
license=('LGPL')
depends=()
makedepends=(
    jq
)
checkdepends=()
optdepends=()
provides=()
conflicts=()
replaces=()
backup=()
options=()
install=
changelog=
source=("git+$url.git#tag=v$pkgver")
noextract=()
sha256sums=('SKIP')
validpgpkeys=()

package() {
    cd OpenTabletDriver

    otb_install_dir="$pkgdir/"/usr/lib/opentabletdriver-config
    install -Dm0644 <(./generate-rules.sh) ${otb_install_dir}/udev/rules.d/70-opentabletdriver.rules
    install -Dm0644 eng/bash/Generic/usr/lib/modprobe.d/99-opentabletdriver.conf -t ${otb_install_dir}/modprobe.d
    install -Dm0644 eng/bash/Generic/usr/lib/modules-load.d/opentabletdriver.conf -t ${otb_install_dir}/modules-load.d
}